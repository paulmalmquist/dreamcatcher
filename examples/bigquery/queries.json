[
  {
    "id": "bq-build-readiness",
    "version": "1.0.0",
    "name": "Build Readiness",
    "description": "SYNTHETIC downstream dashboard. No flight or operational decisions.",
    "connector": "bigquery",
    "sources": [
      "dc-synthetic-demo.analytics_governed.assembly_readiness_v1"
    ],
    "sql": "SELECT assembly_id, program_id, system_name, readiness_pct, updated_at FROM `dc-synthetic-demo.analytics_governed.assembly_readiness_v1` WHERE program_id = @program_id ORDER BY assembly_id",
    "grain": "One row per assembly_id",
    "parameters": {
      "program_id": "string"
    },
    "allowed_groups": [
      "Manufacturing"
    ],
    "data_contract": {
      "products": {
        "dc-synthetic-demo.analytics_governed.assembly_readiness_v1": 1
      },
      "output_columns": [
        "assembly_id",
        "program_id",
        "system_name",
        "readiness_pct",
        "updated_at"
      ],
      "max_bytes_billed": 100000000,
      "max_rows": 100
    }
  },
  {
