DC_ENV=local
DC_DEMO=true
DC_AUTH_MODE=local
DC_ORIGIN=http://localhost:8000
DC_ALLOWED_HOSTS=localhost,127.0.0.1
DC_DEMO_PASSWORD=Dreamcatcher-local-1!
DC_SESSION_SECRET=GENERATE_WITH_SETUP
DC_BUILD_SIGNING_KEY=GENERATE_WITH_SETUP
# Production: disable demo, use OIDC and HTTPS, and provision users by issuer/subject.
DC_OIDC_ISSUER=
DC_OIDC_CLIENT_ID=
DC_OIDC_CLIENT_SECRET=
# Exact permitted app hostnames. Empty permits HTTPS links in local mode.
DC_APP_HOSTS=
# BigQuery is optional; no shared service-account fallback is permitted.
DC_BQ_PROJECT=
DC_BQ_LOCATION=US
DC_BQ_MAX_BYTES=100000000
DC_BQ_PRINCIPALS={}
# WORK-CONNECT integration inventory: integrations/CONNECTIONS.json and CLAUDE.md.
# Keep all values empty until approved work adapters exist. No credentials travel.
DC_BQ_QUERIES_PER_MINUTE=20
DC_DATABASE_URL=
DC_STATE_DATABASE_URL=
# Local automatically migrates; production defaults false. Use migration-only role.
# DC_AUTO_MIGRATE=false
DC_IMAGE_REGISTRIES=
DC_APP_RUNTIME_SUFFIX=
DC_APPROVED_EGRESS=
DC_WORKER_BUILD_KEY=
DC_WORKER_DEPLOY_KEY=
DC_WORKER_AGENT_KEY=
DC_WORKER_DATA_KEY=
DC_GATEWAY_ORIGIN=http://localhost:8000
